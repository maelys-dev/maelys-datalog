CC ?= clang
CFLAGS = -Wall -Wextra -g -I. -Iinclude

ENGINE_SRCS = $(shell sed -n '/^[^\#]/p' build-support/core-sources.txt build-support/standard-sources.txt build-support/native-sources.txt)

COMMON_SRCS =

VENDOR_SRCS =

BUILD_DIR ?= build/asan
UNAME_S := $(shell uname -s)
ASAN_IMAGE ?= maelys-datalog-asan-linux:ubuntu24.04
ASAN_DOCKERFILE ?= docker/asan-linux/Dockerfile
DOCKER_PLATFORM ?= linux/arm64
DOCKER_PLATFORM_ARG = $(if $(DOCKER_PLATFORM),--platform $(DOCKER_PLATFORM),)
PROJECTCTL_DOCKER_LABEL_ARGS = \
	$(if $(strip $(PROJECTCTL_DOCKER_LABEL_MANAGED)),--label "$(PROJECTCTL_DOCKER_LABEL_MANAGED)") \
	$(if $(strip $(PROJECTCTL_DOCKER_LABEL_CYCLE)),--label "$(PROJECTCTL_DOCKER_LABEL_CYCLE)") \
	$(if $(strip $(PROJECTCTL_DOCKER_LABEL_RUN)),--label "$(PROJECTCTL_DOCKER_LABEL_RUN)")

ASAN_FLAGS = -fsanitize=address,undefined \
	-fno-omit-frame-pointer -g -O1

ifeq ($(UNAME_S),Darwin)
ASAN_OPTIONS_VALUE = detect_leaks=0:halt_on_error=1:abort_on_error=1
else
ASAN_OPTIONS_VALUE = detect_leaks=1:halt_on_error=1:abort_on_error=1
endif

ASAN_ENV = ASAN_OPTIONS=$(ASAN_OPTIONS_VALUE) \
	UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1

ASAN_SRCS = $(ENGINE_SRCS) $(COMMON_SRCS) $(VENDOR_SRCS) \
	tests/fixtures/domains/maelys_datalog_example_domains.c \
	bindings/wasm/maelys_datalog_wasm.c \
	tests/helpers/test_log.c \
	tests/helpers/test_framework.c

ASAN_CFLAGS = $(CFLAGS) $(ASAN_FLAGS) -DMAELYS_TESTING
ASAN_RUN_ON_BUILD ?= 1

ASAN_TEST_SRCS = $(wildcard tests/test_*.c)

$(BUILD_DIR)/test_maelys_datalog_modules: ASAN_EXTRA_SRCS = sdk/examples/filter/src/extension.c
$(BUILD_DIR)/test_maelys_datalog_modules: ASAN_CFLAGS += -pthread
$(BUILD_DIR)/test_maelys_datalog_modules: sdk/examples/filter/src/extension.c
$(BUILD_DIR)/test_maelys_datalog_compiler: ASAN_EXTRA_SRCS = sdk/examples/frontend/src/extension.c sdk/examples/backend/src/extension.c
$(BUILD_DIR)/test_maelys_datalog_compiler: sdk/examples/frontend/src/extension.c sdk/examples/backend/src/extension.c
$(BUILD_DIR)/test_maelys_datalog_context: ASAN_EXTRA_SRCS = sdk/examples/frontend/src/extension.c sdk/examples/backend/src/extension.c
$(BUILD_DIR)/test_maelys_datalog_context: ASAN_CFLAGS += -pthread
$(BUILD_DIR)/test_maelys_datalog_context: sdk/examples/frontend/src/extension.c sdk/examples/backend/src/extension.c
$(BUILD_DIR)/test_maelys_datalog_pipeline: ASAN_EXTRA_SRCS = sdk/examples/frontend/src/extension.c
$(BUILD_DIR)/test_maelys_datalog_pipeline: sdk/examples/frontend/src/extension.c

ASAN_HEADERS = $(wildcard include/maelys/*.h src/core/*.h src/compiler/*.h src/public/*.h src/registry/*.h modules/standard/*.h bindings/wasm/*.h)

# The engine, fixtures and helpers are instrumented once into objects and
# linked into every test: compiling them again per test binary made the
# sanitizer job the longest of the CI by a factor of thirty. Only the test
# file and its ASAN_EXTRA_SRCS are compiled per binary.
ASAN_OBJS = $(ASAN_SRCS:%.c=$(BUILD_DIR)/obj/%.o)

$(BUILD_DIR)/obj/%.o: %.c $(ASAN_HEADERS)
	@mkdir -p $(dir $@)
	$(CC) $(ASAN_CFLAGS) -I. -c $< -o $@

$(BUILD_DIR)/%: tests/%.c $(ASAN_OBJS) $(ASAN_HEADERS) | $(BUILD_DIR)
	$(CC) $(ASAN_CFLAGS) -I. $(ASAN_OBJS) $(ASAN_EXTRA_SRCS) $< -o $@
	$(if $(filter 1,$(ASAN_RUN_ON_BUILD)),$(ASAN_ENV) ./$@,@:)

$(BUILD_DIR):
	mkdir -p $@

asan-linux-image:
	docker build $(DOCKER_PLATFORM_ARG) -t $(ASAN_IMAGE) -f $(ASAN_DOCKERFILE) .

test-asan-linux: asan-linux-image
	@echo "==> Standalone Linux ASAN/UBSAN/LSAN in Docker (detect_leaks=1)"
	@docker run --rm \
	  $(DOCKER_PLATFORM_ARG) \
	  $(PROJECTCTL_DOCKER_LABEL_ARGS) \
	  -v "$(CURDIR):/src:ro" \
	  -w /work \
	  $(ASAN_IMAGE) \
	  bash -c 'set -euo pipefail; tar --exclude=.git --exclude=build --exclude=.cache -C /src -cf - . | tar -C /work -xf -; make -B -f Makefile.asan asan'

.PHONY: asan asan-build clean asan-linux-image test-asan-linux

asan-build: $(ASAN_TEST_SRCS:tests/%.c=$(BUILD_DIR)/%)

# Keep historical single-binary targets compiling AND running. The full suite
# builds through a submake without that side effect, then runs each binary once,
# including already up-to-date binaries.
asan:
	$(MAKE) -f Makefile.asan ASAN_RUN_ON_BUILD=0 asan-build
	@set -e; for b in $(ASAN_TEST_SRCS:tests/%.c=$(BUILD_DIR)/%); do echo "--- $$b ---"; $(ASAN_ENV) ./$$b; done

clean:
	rm -rf $(BUILD_DIR)
