CC ?= clang
CFLAGS = -Wall -Wextra -g -I.

ENGINE_SRCS = \
	src/core/maelys_datalog_audit.c \
	src/core/maelys_datalog_diagnostic.c \
	src/core/maelys_datalog_domain_registry.c \
	src/core/maelys_datalog_edb.c \
	src/core/maelys_datalog_lexer.c \
	src/core/maelys_datalog_parser.c \
	src/core/maelys_datalog_policy.c \
	src/core/maelys_datalog_predicate_registry.c \
	src/core/maelys_datalog_symbol_table.c \
	src/manifest/maelys_datalog_manifest_buffer.c \
	src/manifest/maelys_datalog_manifest_file.c

COMMON_SRCS = \
	common/maelys_sha256.c \
	common/maelys_utf8.c

VENDOR_SRCS = vendor/yyjson/yyjson.c

BUILD_DIR ?= build/asan
UNAME_S := $(shell uname -s)
ASAN_IMAGE ?= maelys-datalog-asan-linux:ubuntu24.04
ASAN_DOCKERFILE ?= docker/asan-linux/Dockerfile
DOCKER_PLATFORM ?= linux/arm64
DOCKER_PLATFORM_ARG = $(if $(DOCKER_PLATFORM),--platform $(DOCKER_PLATFORM),)

ASAN_FLAGS = -fsanitize=address,undefined \
	-fno-omit-frame-pointer -g -O1

ifeq ($(UNAME_S),Darwin)
ASAN_OPTIONS_VALUE = detect_leaks=0:halt_on_error=1:abort_on_error=1
else
ASAN_OPTIONS_VALUE = detect_leaks=1:halt_on_error=1:abort_on_error=1
endif

ASAN_ENV = ASAN_OPTIONS=$(ASAN_OPTIONS_VALUE) \
	UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1

ASAN_SRCS = $(ENGINE_SRCS) $(COMMON_SRCS) $(VENDOR_SRCS) \
	examples/domains/maelys_datalog_example_domains.c \
	tests/helpers/test_log.c \
	tests/helpers/test_framework.c

ASAN_CFLAGS = $(CFLAGS) $(ASAN_FLAGS) -DMAELYS_TESTING

ASAN_TEST_SRCS = \
	tests/test_maelys_sha256.c \
	tests/test_maelys_utf8.c \
	tests/test_maelys_datalog_lexer.c \
	tests/test_maelys_datalog_parser.c \
	tests/test_maelys_datalog_edb.c \
	tests/test_maelys_datalog_symbol_table.c \
	tests/test_maelys_datalog_domain_registry.c \
	tests/test_maelys_datalog_manifest_buffer.c \
	tests/test_maelys_datalog_inline_load.c \
	tests/test_maelys_datalog_solver.c \
	tests/test_maelys_datalog_audit.c

$(BUILD_DIR)/%: tests/%.c | $(BUILD_DIR)
	$(CC) $(ASAN_CFLAGS) -I. $(ASAN_SRCS) $< -o $@
	$(ASAN_ENV) ./$@

$(BUILD_DIR):
	mkdir -p $@

asan-linux-image:
	docker build $(DOCKER_PLATFORM_ARG) -t $(ASAN_IMAGE) -f $(ASAN_DOCKERFILE) .

test-asan-linux: asan-linux-image
	@echo "==> Standalone Linux ASAN/UBSAN/LSAN in Docker (detect_leaks=1)"
	@docker run --rm \
	  $(DOCKER_PLATFORM_ARG) \
	  -v "$(CURDIR):/src:ro" \
	  -w /work \
	  $(ASAN_IMAGE) \
	  bash -c 'set -euo pipefail; tar --exclude=.git --exclude=build --exclude=.cache -C /src -cf - . | tar -C /work -xf -; make -B -f Makefile.asan asan'

.PHONY: asan clean asan-linux-image test-asan-linux

asan: $(ASAN_TEST_SRCS:tests/%.c=$(BUILD_DIR)/%)

clean:
	rm -rf $(BUILD_DIR)
