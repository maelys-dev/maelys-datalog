; MAELYS-DATALOG-v2 source syntax (RFC 5234 + RFC 7405)
program = ignored *(clause ignored)
clause = atom ignored (dot / (neck ignored body dot))
body = body-item *(comma body-item)
body-item = or-group / negated-atom / comparison / atom
or-group = atom 1*(ignored %s"or" ignored atom)
negated-atom = %s"not" ignored lparen atom rparen
comparison = comparison-operand ignored comparator ignored comparison-operand
comparison-operand = arithmetic-expression / string / boolean
arithmetic-expression = arithmetic-product *(ignored add-op ignored arithmetic-product)
arithmetic-product = arithmetic-primary *(ignored %s"*" ignored arithmetic-primary)
arithmetic-primary = integer / variable / (lparen arithmetic-expression rparen)
add-op = %s"+" / %s"-"
comparator = %s"=" / %s"!=" / %s"<" / %s"<=" / %s">" / %s">="
atom = predicate lparen [term *(comma term)] rparen
term = string / integer / boolean / variable / anonymous-variable
predicate = lower *predicate-char
predicate-char = lower / digit / %s"_"
variable = upper *variable-char
variable-char = upper / lower / digit / %s"_"
anonymous-variable = %s"_"
boolean = %s"true" / %s"false"
integer = 1*digit
string = dquote *string-char dquote
string-char = %x00-21 / %x23-5B / %x5D-7F / utf8-2 / utf8-3 / utf8-4
utf8-2 = %xC2-DF utf8-tail
utf8-3 = %xE0 %xA0-BF utf8-tail / %xE1-EC 2utf8-tail / %xED %x80-9F utf8-tail / %xEE-EF 2utf8-tail
utf8-4 = %xF0 %x90-BF 2utf8-tail / %xF1-F3 3utf8-tail / %xF4 %x80-8F 2utf8-tail
utf8-tail = %x80-BF
ignored = *(space / tab / cr / lf / line-comment / block-comment)
line-comment = %s"%" *(%x00-09 / %x0B-0C / %x0E-7F / utf8-2 / utf8-3 / utf8-4) [cr] [lf]
block-comment = %s"/*" block-body
block-body = %s"*/" / block-plain block-body / %s"/" block-after-slash / %s"*" block-after-star
block-after-slash = block-plain block-body / %s"/" block-after-slash
block-after-star = %s"*/" / %s"*" block-after-star / block-plain block-body / %s"/" block-after-slash
block-plain = %x00-29 / %x2B-2E / %x30-7F / utf8-2 / utf8-3 / utf8-4
comma = ignored %s"," ignored
lparen = ignored %s"(" ignored
rparen = ignored %s")" ignored
neck = %s":-"
dot = ignored %s"."
lower = %x61-7A
upper = %x41-5A
digit = %x30-39
space = %x20
tab = %x09
cr = %x0D
lf = %x0A
dquote = %x22
