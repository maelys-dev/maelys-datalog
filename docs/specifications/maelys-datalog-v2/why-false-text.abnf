; SPDX-License-Identifier: MIT
; MAELYS-DATALOG-v2 canonical Why-false document; see semantics.md for ordering.
why-false-document = version-line document-line status-line query-line summary-line limits-line *diagnostic-block
version-line = %s"MAELYS-DATALOG-v2" lf
document-line = %s"document=why-false" lf
status-line = %s"status=" (%s"complete" / %s"truncated" / %s"not-applicable") lf
query-line = %s"query=" fact %s" origin=" origin lf
summary-line = %s"summary=" (%s"none" / %s"no-candidate-rule") lf
limits-line = %s"limit-hits=" limit-hits %s" candidate-rules=" decimal %s" substitutions=" decimal %s" diagnostics=" decimal %s" filter-cost=" decimal lf
limit-hits = %s"none" / (limit-name *(%s"," limit-name))
limit-name = %s"candidate-rules" / %s"substitutions" / %s"depth" / %s"diagnostics" / %s"filter-cost"
diagnostic-block = diagnostic-line *binding-line *support-line obstacle-line
diagnostic-line = %s"diagnostic=" decimal %s" rule=" decimal %s" depth=" decimal %s" target=" fact lf
binding-line = %s"binding=" decimal %s" value=" term lf
support-line = %s"support=" decimal %s" body=" decimal %s" origin=" origin %s" fact=" fact lf
obstacle-line = pattern-obstacle / comparison-obstacle / filter-obstacle / count-obstacle
count-obstacle = %s"obstacle=count-mismatch" obstacle-location %s" observed=" decimal %s" expected=" term %s" projected=?" decimal %s" pattern=" pattern lf
obstacle-location = %s" body=" decimal %s" origin=" origin
pattern-obstacle = %s"obstacle=" pattern-kind obstacle-location %s" pattern=" pattern lf
pattern-kind = %s"positive-no-match" / %s"negative-contradicted" / %s"recursive-no-base-support"
comparison-obstacle = %s"obstacle=comparison-false" obstacle-location %s" lhs=" term %s" op=" comparator %s" rhs=" term lf
filter-obstacle = %s"obstacle=filter-false" obstacle-location %s" filter=" quoted-string %s" semantic=" quoted-string %s" value=" term %s" pattern=" quoted-string lf
pattern = quoted-name %s"(" [pattern-term *(%s"," pattern-term)] %s")"
pattern-term = term / (%s"?" decimal)
origin = %s"edb" / %s"policy-fact" / %s"idb" / %s"none"
fact = quoted-name %s"(" [term *(%s"," term)] %s")"
quoted-name = dquote 1*quoted-byte dquote
term = quoted-string / signed-integer / boolean
quoted-string = dquote *quoted-byte dquote
quoted-byte = printable-safe / named-escape / hex-escape / utf8-2 / utf8-3 / utf8-4
printable-safe = %x20-21 / %x23-5B / %x5D-7E
named-escape = %x5C.22 / %x5C.5C / %x5C.6E / %x5C.72 / %x5C.74
hex-escape = %s"\x" upper-hex upper-hex
comparator = %s"=" / %s"!=" / %s"<" / %s"<=" / %s">" / %s">="
signed-integer = [%s"-"] decimal
decimal = 1*digit
boolean = %s"true" / %s"false"
upper-hex = digit / %x41-46
digit = %x30-39
dquote = %x22
lf = %x0A
utf8-2 = %xC2-DF utf8-tail
utf8-3 = %xE0 %xA0-BF utf8-tail / %xE1-EC 2utf8-tail / %xED %x80-9F utf8-tail / %xEE-EF 2utf8-tail
utf8-4 = %xF0 %x90-BF 2utf8-tail / %xF1-F3 3utf8-tail / %xF4 %x80-8F 2utf8-tail
utf8-tail = %x80-BF
