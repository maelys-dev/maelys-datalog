CC ?= clang
CFLAGS_COMMON = -Wall -Wextra -g -I.
BUILD_ROOT ?= bench/build
RESULT_DIR ?= bench/results
REPORT_DIR ?= bench/reports
BASELINE_DIR ?= bench/baseline
BASELINE_JSON ?= $(BASELINE_DIR)/linux-arm64-clang18-O2.json
ASAN_IMAGE ?= maelys-datalog-asan-linux:ubuntu24.04
DOCKER_PLATFORM ?= linux/arm64
DOCKER_PLATFORM_ARG = $(if $(DOCKER_PLATFORM),--platform $(DOCKER_PLATFORM),)

ENGINE_SRCS = \
	src/core/maelys_datalog_audit.c \
	src/core/maelys_datalog_diagnostic.c \
	src/core/maelys_datalog_domain_registry.c \
	src/core/maelys_datalog_edb.c \
	src/core/maelys_datalog_lexer.c \
	src/core/maelys_datalog_parser.c \
	src/core/maelys_datalog_predicate_registry.c \
	src/core/maelys_datalog_ruleset.c \
	src/core/maelys_datalog_ruleset_canonical.c \
	src/core/maelys_datalog_solver.c \
	src/core/maelys_datalog_symbol_table.c \
	src/core/maelys_datalog_decision.c \
	src/manifest/maelys_datalog_manifest_buffer.c \
	src/manifest/maelys_datalog_manifest_file.c

COMMON_SRCS = \
	common/maelys_sha256.c \
	common/maelys_utf8.c

VENDOR_SRCS = vendor/yyjson/yyjson.c
BENCH_SRC = bench/bench_datalog.c
BENCH_SRCS = $(ENGINE_SRCS) $(COMMON_SRCS) $(VENDOR_SRCS) $(BENCH_SRC)

COMMIT ?= $(shell git rev-parse HEAD 2>/dev/null || echo unknown)
DIRTY ?= $(shell test -z "$$(git status --short 2>/dev/null)" && echo false || echo true)
COMPILER := $(shell $(CC) --version 2>/dev/null | head -n 1 | sed 's/[^A-Za-z0-9._-]/_/g')

BENCH_DEFS = \
	-DBENCH_COMMIT=\"$(COMMIT)\" \
	-DBENCH_DIRTY=\"$(DIRTY)\" \
	-DBENCH_COMPILER=\"$(COMPILER)\"

SMALL_O0_DIR = $(BUILD_ROOT)/bench-small-O0
SMALL_O2_DIR = $(BUILD_ROOT)/bench-small-O2
LARGE_O0_DIR = $(BUILD_ROOT)/bench-large-O0
LARGE_O2_DIR = $(BUILD_ROOT)/bench-large-O2

BENCH_SMALL_O0 = $(SMALL_O0_DIR)/bench_datalog
BENCH_SMALL_O2 = $(SMALL_O2_DIR)/bench_datalog
BENCH_LARGE_O0 = $(LARGE_O0_DIR)/bench_datalog
BENCH_LARGE_O2 = $(LARGE_O2_DIR)/bench_datalog

SMALL_DEFS = -DBENCH_PROFILE=\"SMALL\"
LARGE_DEFS = -DMAELYS_DATALOG_PROFILE_LARGE -DBENCH_PROFILE=\"LARGE\"

.PHONY: bench bench-small bench-large bench-all \
	check check-small check-large check-all check-selftest \
	bench-linux bench-linux-small bench-linux-large bench-baseline-update \
	clean clean-results

bench: bench-small

bench-small: $(BENCH_SMALL_O0) $(BENCH_SMALL_O2)
	bash bench/run_benchmarks.sh small "$(BENCH_SMALL_O0)" "$(BENCH_SMALL_O2)"

bench-large: $(BENCH_LARGE_O0) $(BENCH_LARGE_O2)
	bash bench/run_benchmarks.sh large "$(BENCH_LARGE_O0)" "$(BENCH_LARGE_O2)"

bench-all: bench-small bench-large

check: check-small

check-small:
	MAELYS_BENCH_CSV_O0="$(RESULT_DIR)/datalog-bench-small-O0.csv" \
	MAELYS_BENCH_CSV_O2="$(RESULT_DIR)/datalog-bench-small-O2.csv" \
	MAELYS_BENCH_JSON_O0="$(RESULT_DIR)/datalog-bench-small-O0.json" \
	MAELYS_BENCH_JSON_O2="$(RESULT_DIR)/datalog-bench-small-O2.json" \
	bash bench/check_regression.sh

check-large:
	MAELYS_BENCH_CSV_O0="$(RESULT_DIR)/datalog-bench-large-O0.csv" \
	MAELYS_BENCH_CSV_O2="$(RESULT_DIR)/datalog-bench-large-O2.csv" \
	MAELYS_BENCH_JSON_O0="$(RESULT_DIR)/datalog-bench-large-O0.json" \
	MAELYS_BENCH_JSON_O2="$(RESULT_DIR)/datalog-bench-large-O2.json" \
	bash bench/check_regression.sh

check-all: check-small check-large

check-selftest:
	bash bench/check_selftest.sh

$(BENCH_SMALL_O0): $(BENCH_SRCS) | $(SMALL_O0_DIR)
	$(CC) $(CFLAGS_COMMON) -O0 $(BENCH_DEFS) $(SMALL_DEFS) -DBENCH_OPT_LEVEL=\"-O0\" -DBENCH_CFLAGS=\"-Wall_-Wextra_-g_-I._-O0\" $(BENCH_SRCS) -o $@

$(BENCH_SMALL_O2): $(BENCH_SRCS) | $(SMALL_O2_DIR)
	$(CC) $(CFLAGS_COMMON) -O2 $(BENCH_DEFS) $(SMALL_DEFS) -DBENCH_OPT_LEVEL=\"-O2\" -DBENCH_CFLAGS=\"-Wall_-Wextra_-g_-I._-O2\" $(BENCH_SRCS) -o $@

$(BENCH_LARGE_O0): $(BENCH_SRCS) | $(LARGE_O0_DIR)
	$(CC) $(CFLAGS_COMMON) -O0 $(LARGE_DEFS) $(BENCH_DEFS) -DBENCH_OPT_LEVEL=\"-O0\" -DBENCH_CFLAGS=\"-Wall_-Wextra_-g_-I._-DMAELYS_DATALOG_PROFILE_LARGE_-O0\" $(BENCH_SRCS) -o $@

$(BENCH_LARGE_O2): $(BENCH_SRCS) | $(LARGE_O2_DIR)
	$(CC) $(CFLAGS_COMMON) -O2 $(LARGE_DEFS) $(BENCH_DEFS) -DBENCH_OPT_LEVEL=\"-O2\" -DBENCH_CFLAGS=\"-Wall_-Wextra_-g_-I._-DMAELYS_DATALOG_PROFILE_LARGE_-O2\" $(BENCH_SRCS) -o $@

$(SMALL_O0_DIR) $(SMALL_O2_DIR) $(LARGE_O0_DIR) $(LARGE_O2_DIR):
	mkdir -p $@

clean-results:
	rm -f $(RESULT_DIR)/*.csv $(RESULT_DIR)/*.json
	rm -rf $(RESULT_DIR)/graphs
	rm -f $(REPORT_DIR)/datalog-performance-report*.md

clean:
	rm -rf $(BUILD_ROOT)
	rm -f $(RESULT_DIR)/*.csv $(RESULT_DIR)/*.json
	rm -rf $(RESULT_DIR)/graphs
	rm -f $(REPORT_DIR)/datalog-performance-report*.md

bench-linux: bench-linux-small

bench-linux-small:
	@echo "==> Standalone Linux SMALL benchmark run in Docker"
	@mkdir -p "$(RESULT_DIR)"
	@$(MAKE) --no-print-directory -f Makefile.asan asan-linux-image
	@docker run --rm \
	  $(DOCKER_PLATFORM_ARG) \
	  -v "$(CURDIR):/src:ro" \
	  -v "$(CURDIR)/$(RESULT_DIR):/work/bench/results:rw" \
	  -w /work \
	  $(ASAN_IMAGE) \
	  bash -c 'set -euo pipefail; tar --exclude=.git --exclude=build --exclude=.cache --exclude=bench/results -C /src -cf - . | tar -C /work -xf -; make --no-print-directory -f Makefile.bench bench-small COMMIT="$(COMMIT)" DIRTY="$(DIRTY)"; chmod -R a+rw /work/bench/results || true'

bench-linux-large:
	@echo "==> Standalone Linux LARGE benchmark run in Docker"
	@mkdir -p "$(RESULT_DIR)"
	@$(MAKE) --no-print-directory -f Makefile.asan asan-linux-image
	@docker run --rm \
	  $(DOCKER_PLATFORM_ARG) \
	  -v "$(CURDIR):/src:ro" \
	  -v "$(CURDIR)/$(RESULT_DIR):/work/bench/results:rw" \
	  -w /work \
	  $(ASAN_IMAGE) \
	  bash -c 'set -euo pipefail; tar --exclude=.git --exclude=build --exclude=.cache --exclude=bench/results -C /src -cf - . | tar -C /work -xf -; make --no-print-directory -f Makefile.bench bench-large COMMIT="$(COMMIT)" DIRTY="$(DIRTY)"; chmod -R a+rw /work/bench/results || true'

bench-baseline-update:
	@mkdir -p "$(BASELINE_DIR)"
	@$(MAKE) --no-print-directory -f Makefile.bench bench-linux-small
	cp "$(RESULT_DIR)/datalog-bench-small-O2.json" "$(BASELINE_JSON)"
